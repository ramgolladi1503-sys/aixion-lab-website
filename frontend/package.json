{
  "name": "aixion-lab-website",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:interaction": "playwright test tests/visual/interaction.spec.mjs",
    "test:motion": "playwright test tests/visual/motion.spec.mjs --project=chromium-motion",
    "visual:capture": "playwright test tests/visual/capture.spec.mjs --project=chromium-motion",
    "visual:validate": "playwright test",
    "verify": "npm run build && npm run visual:validate"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.2.2"
  }
}
